# Google Cloud GenAI API Key (Gemini 2.5 Flash / Gemini 2.0 Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Google Cloud Project ID (activates Google Cloud Firestore audit trail)
# If omitted or empty, VeriBrake automatically uses its zero-dependency SQLite/in-memory store
GOOGLE_CLOUD_PROJECT=

# Optional: Port for local or Cloud Run execution (Cloud Run defaults to 8080)
PORT=8080
HOST=0.0.0.0

# Optional: Real-time Compliance Webhook alerts when VeriBrake Circuit Breaker trips
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
